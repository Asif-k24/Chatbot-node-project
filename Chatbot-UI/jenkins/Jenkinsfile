pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE = 'your-dockerhub-username/node-app'  // Change this to your actual DockerHub username
        KUBECONFIG_FILE = credentials('kubeconfig')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'staging',
                    url: 'https://github.com/Asif-k24/Chatbot-node-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install --legacy-peer-deps
                '''
            }
        }

        stage('Build Node App') {
            steps {
                sh '''
                    npm run build
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Docker Login & Push') {
            steps {
                script {
                    // Login to DockerHub
                    sh """
                        echo "\${DOCKERHUB_CREDENTIALS_PSW}" | docker login -u "\${DOCKERHUB_CREDENTIALS_USR}" --password-stdin
                    """
                    
                    // Push with build number tag
                    sh "docker push ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                    
                    // Tag as latest and push
                    sh "docker tag ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ${DOCKER_IMAGE}:latest"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Write kubeconfig to file
                    writeFile file: 'kubeconfig.yaml', text: "${KUBECONFIG_FILE}"
                    
                    sh '''
                        # Apply namespace first
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/namespace.yaml
                        
                        # Wait for namespace to be created
                        sleep 5
                        
                        # Apply other resources
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/secrets.yaml
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/configmap.yaml
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/deployment.yaml
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/service.yaml
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/ingress.yaml
                        
                        # Update deployment image
                        kubectl --kubeconfig=kubeconfig.yaml set image deployment/node-app -n chatbot-app node-app=${DOCKER_IMAGE}:${BUILD_NUMBER} || true
                        
                        # Rollout restart to ensure new image is used
                        kubectl --kubeconfig=kubeconfig.yaml rollout restart deployment/node-app -n chatbot-app
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    sh '''
                        echo "Waiting for the pod to start..."
                        # Wait for rollout to complete
                        kubectl --kubeconfig=kubeconfig.yaml rollout status deployment/node-app -n chatbot-app --timeout=120s
                        
                        # Get service URL for testing
                        # If you're using a LoadBalancer or have external IP
                        # SERVICE_URL=$(kubectl --kubeconfig=kubeconfig.yaml get svc node-app-service -n chatbot-app -o jsonpath='{.status.loadBalancer.ingress[0].ip}')
                        # curl -f http://${SERVICE_URL}:3000 || exit 1
                        
                        # Alternative: Use port-forward for testing
                        echo "Smoke test passed - deployment is ready"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
            script {
                // Clean up Docker images locally to save space
                sh '''
                    docker rmi ${DOCKER_IMAGE}:${BUILD_NUMBER} || true
                    docker rmi ${DOCKER_IMAGE}:latest || true
                '''
                // Clean workspace
                cleanWs()
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
