pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE = 'asif0098'  // Change to your actual username
        KUBECONFIG_FILE = credentials('kubeconfig')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'staging',
                    url: 'https://github.com/Asif-k24/Chatbot-node-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install --legacy-peer-deps
                '''
            }
        }

        stage('Build Node App') {
            steps {
                sh '''
                    npm run build
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // Build Docker image
                    sh "docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ."
                }
            }
        }

        stage('Docker Login & Push') {
            steps {
                script {
                    // Login to DockerHub
                    sh """
                        echo "\${DOCKERHUB_CREDENTIALS_PSW}" | docker login -u "\${DOCKERHUB_CREDENTIALS_USR}" --password-stdin
                    """
                    
                    // Push with build number tag
                    sh "docker push ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                    
                    // Tag as latest and push
                    sh "docker tag ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ${DOCKER_IMAGE}:latest"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Write kubeconfig to file
                    writeFile file: 'kubeconfig.yaml', text: "${KUBECONFIG_FILE}"
                    
                    sh '''
                        # Apply namespace
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/namespace.yaml
                        
                        # Wait for namespace
                        sleep 3
                        
                        # Apply all manifests
                        kubectl --kubeconfig=kubeconfig.yaml apply -f kubernetes/manifests/ -R
                        
                        # Update deployment with new image
                        kubectl --kubeconfig=kubeconfig.yaml set image deployment/node-app node-app=${DOCKER_IMAGE}:${BUILD_NUMBER} -n chatbot-app
                        
                        # Wait for rollout
                        kubectl --kubeconfig=kubeconfig.yaml rollout status deployment/node-app -n chatbot-app --timeout=180s
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    sh '''
                        echo "Performing smoke test..."
                        # Get pod name
                        POD_NAME=$(kubectl --kubeconfig=kubeconfig.yaml get pods -n chatbot-app -l app=node-app -o jsonpath="{.items[0].metadata.name}")
                        
                        # Check if pod is running
                        kubectl --kubeconfig=kubeconfig.yaml exec -n chatbot-app $POD_NAME -- curl -s http://localhost:3000/health || echo "Health check failed"
                        
                        echo "Smoke test completed"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
            script {
                // Clean up Docker images
                sh '''
                    docker rmi ${DOCKER_IMAGE}:${BUILD_NUMBER} || true
                    docker rmi ${DOCKER_IMAGE}:latest || true
                    rm -f kubeconfig.yaml || true
                '''
                // Clean workspace
                cleanWs()
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
