pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE = 'your-dockerhub-username/node-app'
        KUBECONFIG = credentials('kubeconfig')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'staging',
                    url: 'https://github.com/Asif-k24/Chatbot-node-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install --legacy-peer-deps
                '''
            }
        }

        stage('Build Node App') {
            steps {
                sh '''
                    npm run build
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${env.BUILD_NUMBER}", "./docker")
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push()
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push("latest")
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f kubernetes/manifests/namespace.yaml
                    kubectl apply -f kubernetes/manifests/secrets.yaml
                    kubectl apply -f kubernetes/manifests/configmap.yaml

                    kubectl set image deployment/node-app node-app=${DOCKER_IMAGE}:${BUILD_NUMBER}

                    kubectl apply -f kubernetes/manifests/deployment.yaml
                    kubectl apply -f kubernetes/manifests/service.yaml
                    kubectl apply -f kubernetes/manifests/ingress.yaml
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    echo "Waiting for the pod to start..."
                    sleep 20
                    curl -f http://localhost:3000 || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {
            echo 'Cleaning workspace...'
            script {
                cleanWs()   // FIXED
            }
        }
    }
}
